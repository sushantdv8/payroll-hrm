# /etc/payroll/app.env - settings of the web application service (payroll-app.service)
# Copy to /etc/payroll/app.env, replace every CHANGE_ME, then:  chown root:payroll /etc/payroll/app.env && chmod 640 /etc/payroll/app.env
# One KEY=value per line, no quotes, no "export". Do not put real values in this example file.

# Address and secret of the database gateway (see gateway.env). With these two set, the application stores everything in
# PostgreSQL through the gateway; no Cloudflare database or bucket is used.
DB_GATEWAY_URL=http://127.0.0.1:5790
DB_GATEWAY_SECRET=CHANGE_ME_same_value_as_GATEWAY_SECRET

NODE_ENV=production

# Optional. Secret shared with the sign-in layer so that it can write sign-ins / sign-outs to the activity log (guide, section 4.6).
# Create with:  openssl rand -hex 24   Leave the line out if the layer does not report sign-ins.
# PAYROLL_INTERNAL_KEY=CHANGE_ME_random_48_hex_characters

# The web port is given in the service file (-p 3000); the application listens on 127.0.0.1 only.
