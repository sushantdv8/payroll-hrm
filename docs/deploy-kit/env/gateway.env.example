# /etc/payroll/gateway.env - settings of the database gateway service (payroll-gateway.service)
# Copy to /etc/payroll/gateway.env, replace every CHANGE_ME, then:  chown root:payroll /etc/payroll/gateway.env && chmod 640 /etc/payroll/gateway.env
# One KEY=value per line, no quotes, no "export". Do not put real values in this example file.

# PostgreSQL connection. Use a password of letters and digits only (openssl rand -hex 24), otherwise special characters
# (@ : / # ?) must be URL-encoded.
DATABASE_URL=postgres://payroll:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/payroll

# Shared secret between the app and this service: 32 or more random characters (openssl rand -hex 32).
# The app (app.env) must have exactly the same value in DB_GATEWAY_SECRET.
GATEWAY_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS

# Where the gateway listens. Keep 127.0.0.1: only the app on this server may reach it.
PORT=5790
HOST=127.0.0.1
