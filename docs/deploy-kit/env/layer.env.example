# /etc/payroll/layer.env - settings of the sign-in layer (payroll-layer.service)
# Copy to /etc/payroll/layer.env, replace every CHANGE_ME, then:  chown root:payroll /etc/payroll/layer.env && chmod 640 /etc/payroll/layer.env
# One KEY=value per line, no quotes, no "export". Do not put real values in this example file.

# The address people type (with https://, no path). The layer refuses requests for any other host name and accepts changing requests only from this origin.
PUBLIC_ORIGIN=https://hrm.example.com

# The application (stays on this server; never open this port to the outside).
UPSTREAM=http://127.0.0.1:3000

# Where the layer listens: nginx proxies to it. Keep 127.0.0.1.
HOST=127.0.0.1
PORT=8080

# Super Admin (admin01) password, as a scrypt hash. Do NOT type a password here: run
#     sudo node /opt/payroll/app/payroll-web/deploy/signin-layer/make-admin-hash.mjs --write-to /etc/payroll/layer.env
# (it asks for the password, shows nothing while you type, and writes this line). The layer does not start without it.
ADMIN_PASSWORD_HASH=

# The same value as PAYROLL_INTERNAL_KEY in app.env: with it the layer writes sign-ins, failed sign-ins and sign-outs to the activity log.
PAYROLL_INTERNAL_KEY=CHANGE_ME_same_value_as_in_app.env

# Optional (defaults shown): minutes without a request before a session ends, and the longest a session lasts.
#IDLE_MINUTES=120
#ABSOLUTE_HOURS=12
